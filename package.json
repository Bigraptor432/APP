{
  "name": "kgbtools",
  "private": true,
  "version": "3.15.31",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:app": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:app": "vite build && electron-packager . kgbtools --platform=win32 --arch=x64 --out=release --overwrite --electron-version=33.4.11 --icon=electron/icon.ico --ignore=node_modules --ignore=/src --ignore=release",
    "build:portable": "vite build && electron-builder --win portable",
    "build:mac": "vite build && electron-builder --mac",
    "make-icon": "node scripts/make-icon.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.kgbtools.pentest",
    "productName": "KGBtools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "kgbtools.exe"
    },
    "portable": {
      "artifactName": "kgbtools.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "artifactName": "kgbtools-${version}-${arch}.dmg",
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "artifactName": "kgbtools-${version}-${arch}.dmg"
    }
  }
}
